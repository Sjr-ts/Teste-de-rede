# ===================== DEPENDENCIAS =====================
node_modules/

# ===================== INSTALADORES / BINARIOS PESADOS =====================
# Baixar direto do site do Zabbix (17 MB)
zabbix-deploy/*.msi
*.msi

# ===================== SEGREDOS / CREDENCIAIS =====================
# Chave PSK do agente Zabbix (NAO versionar)
zabbix-deploy/psk.txt
*.psk
.env
.env.*

# ===================== LOGS / RUNTIME =====================
server.log
server.err.log
server_output.txt
log.txt
*.log

# ===================== BACKUPS EDITORAIS =====================
*.bak
*.orig
*.tmp

# ===================== SISTEMA =====================
Thumbs.db
desktop.ini
.DS_Store

# ===================== ARQUIVOS AVULSOS LOCAIS =====================
# scripts/estados de uso unico no servidor — nao versionar
j.py
vigia-estado.txt
vigia-ultima-restart.txt

# Gerados pelo CRIAR-ATALHOS.ps1 na maquina do usuario
ABRIR-PAINEL.vbs
ABRIR-ZABBIX.vbs

# ===================== CONFIG LOCAL (credenciais Zabbix) =====================
# Copie de monitor/*.example.json e preencha a senha localmente
monitor/config.json
monitor/zabbix-config.json
monitor/zabbix-inventario.txt
monitor/users.json
monitor/auth-secret.json
monitor/webhook-secret.json
monitor/api-tokens.json

# ===================== DADOS DE RUNTIME (gerados pelo monitor) =====================
# Telemetria em tempo real — nao e conteudo do repositorio
monitor/data/state.json
monitor/data/alerts.json
monitor/data/agg/
monitor/data/raw/
monitor/data/targets.json
monitor/data/targets.json.bak-*
api-data-dump.json
*.bak-*
