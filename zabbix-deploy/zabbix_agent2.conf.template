# Template de referencia — Zabbix Agent 2 (Windows)
# Use o instalador unico: "execução bat\instalar-tudo.bat"
# Ele detecta Server/Hostname/IP e gera o conf final com IP adaptativo.

Server=SERVER_IP_AQUI
ServerActive=SERVER_IP_AQUI
Hostname=NOME_DO_PC_AQUI

# IP adaptativo: metadata DINAMICO (contem o IP atual do PC)
HostMetadataItem=inv.meta
UnsafeUserParameters=1
UserParameter=inv.meta,powershell -NoProfile -ExecutionPolicy Bypass -File "C:\Program Files\Zabbix Agent 2\scripts\inv-meta.ps1"

LogFile=C:\Program Files\Zabbix Agent 2\zabbix_agent2.log
LogFileSize=10
Timeout=30
ListenPort=10050
